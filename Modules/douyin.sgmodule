#! name=TikTok China short video to advertise
#! desc=TikTok records a good life (remove advertisements and watermarks of recommendations, followers, search and other interfaces)
#!system=ios

[URL Rewrite]
^https?:\/\/.+?\.amemv\.com\/aweme\/(v\d+)\/feed\/ https://aweme.snssdk.com/aweme/$1/feed/ header
^https?:\/\/.+?\.amemv\.com\/aweme\/(v\d+)\/aweme\/post\/ https://aweme.snssdk.com/aweme/$1/aweme/post/ header
^https?:\/\/.+?\.amemv\.com\/aweme\/(v\d+)\/follow\/feed\/ https://aweme.snssdk.com/aweme/$1/follow/feed/ header
^https?:\/\/.+?\.amemv\.com\/aweme\/(v\d+)\/nearby\/feed\/ https://aweme.snssdk.com/aweme/$1/nearby/feed/ header
^https?:\/\/.+?\.amemv\.com\/aweme\/(v\d+)\/search\/item\/ https://aweme.snssdk.com/aweme/$1/search/item/ header
^https?:\/\/.+?\.amemv\.com\/aweme\/(v\d+)\/general\/search\/single\/ https://aweme.snssdk.com/aweme/$1/general/search/single/ header
^https?:\/\/.+?\.amemv\.com\/aweme\/(v\d+)\/hot\/search\/video\/list\/ https://aweme.snssdk.com/aweme/$1/hot/search/video/list/ header

[Script]
douyin_ad = type=http-response,pattern=^https?:\/\/aweme\.snssdk\.com\/aweme\/v\d+\/(feed|aweme\/post|follow\/feed|nearby\/feed|search\/item|general\/search\/single|hot\/search\/video\/list)\/,requires-body=1,max-size=-1,script-path=https://Choler.github.io/Surge/Script/douyin.js

[MITM]
hostname = %APPEND% *.amemv.com, aweme.snssdk.com
